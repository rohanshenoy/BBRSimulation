# planck.mac — 4K Planck emitter smoke test.
# Fires 10 000 optical photons from a 1cm x 1cm x 1mm box patch at T=4K.
# Output: build/planck_output.csv (one energy_eV per line).
# Validate with: conda run -n bbrsim python scripts/check_planck_spectrum.py
# Expected peak: u = E/(kB*T) ~ 1.59  -> E ~ 5.5e-4 eV (~133 GHz)

/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/run/numberOfThreads 1
/run/initialize

/random/setSeeds 9999 8888

/run/beamOn 10000
