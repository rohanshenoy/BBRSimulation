/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/random/setSeeds 7777 6666
/run/initialize
# /bbr/thermal/setT is registered by BBRConfigManager at startup (valid in PreInit and Idle)
# and broadcast to worker threads, so each worker's config clone picks it up.
/bbr/thermal/setT 10
/run/beamOn 1000000
