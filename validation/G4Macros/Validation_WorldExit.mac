# Validation_WorldExit.mac — 2000 photons fired from (-20,0,0) mm toward -x into empty
# space. No boundary is ever crossed; every photon leaves the world.
# Regression for abspoints.term_status: every row must read WorldExit
# (never "unknown" or a stale boundary status).
#
# Validate:
#   conda run -n bbrsim python <repo>/validation/check_term_status.py output/bbr.root
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/random/setSeeds 31 7
/run/initialize
/bbr/gun/mode true
/bbr/gun/dirX -1.0
/run/beamOn 2000
