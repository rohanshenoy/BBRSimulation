# test_of_cu.mac
# Smoke test for OF_Cu (Serov 2016 OF copper at 4 K, sigma_eff = 1/rho_0).
# Gun mode: every photon hits solid Cu at z=5mm (away from cracks at z=0, z=3mm).
# 2000 events → 2000 Cu hits → 2 [BBR] reflectance lines.
# Expect A_obs ~ 1.1e-3 (higher loss than OFHC_Cu at 500 GHz).
/run/verbose 0
/event/verbose 0
/random/setSeeds 12345 67890
/bbr/det/setCuMaterial OF_Cu
/run/initialize
/bbr/gun/mode true
/bbr/gun/posX -20.0
/bbr/gun/posY 0.0
/bbr/gun/posZ 5.0
/bbr/gun/dirX 1.0
/bbr/gun/dirY 0.0
/bbr/gun/dirZ 0.0
/bbr/gun/energy_eV 2.07e-3
/run/beamOn 2000
