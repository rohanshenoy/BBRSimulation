# test_hp_cu.mac
# Smoke test for HP_Cu (RRR=6, full Drude model at 4K via BBRMaterials::GetCopper(6,4.0)).
# Gun mode: every photon hits solid Cu at z=5mm (away from cracks at z=0, z=3mm).
# 2000 events → 2000 Cu hits → 2 [BBR] reflectance lines.
# Expect A_obs: OF_Cu > HP_Cu > OFHC_Cu (higher RRR → higher σ → lower loss).
/run/verbose 0
/event/verbose 0
/random/setSeeds 12345 67890
/bbr/det/setCuMaterial HP_Cu
/run/initialize
/bbr/gun/mode true
/bbr/gun/posX -20.0
/bbr/gun/posY 0.0
/bbr/gun/posZ 5.0
/bbr/gun/dirX 1.0
/bbr/gun/dirY 0.0
/bbr/gun/dirZ 0.0
/bbr/gun/energy_eV 2.07e-3
/run/beamOn 2000
