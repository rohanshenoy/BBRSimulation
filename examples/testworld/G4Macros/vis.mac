# vis.mac — interactive view of the test world, run by bbrsimTestWorld when it
# is started with no macro argument.
/control/verbose 2
/run/verbose 2
/run/initialize
/vis/open
/vis/viewer/set/autoRefresh false
/vis/verbose errors
#
# Geometry: hide the 50 cm world box; draw the Cu slab translucent and the two
# HFSS crack volumes in colour (crack1 blue, crack2 purple).
/vis/drawVolume
/vis/geometry/set/visibility logic-World 0 false
/vis/geometry/set/colour logic-CuSlab 0 0.85 0.45 0.2 0.35
/vis/geometry/set/colour InfParallelPlate_crack1Rohan 0 0 0.4 1 1
/vis/geometry/set/colour InfParallelPlate_crack2 0 0.8 0 0.8 1
/vis/viewer/set/style surface
/vis/viewer/set/background white
/vis/viewer/set/viewpointThetaPhi 65 30 deg
/vis/viewer/set/targetPoint -25 0 0 mm
/vis/viewer/zoomTo 3.2
#
# Photon tracks in red, accumulated over all the events of a run.
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/set 0 red
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts true
/vis/modeling/trajectories/drawByCharge-0/default/setStepPtsSize 2
/vis/scene/endOfEventAction accumulate
/vis/viewer/set/autoRefresh true
/vis/verbose warnings
