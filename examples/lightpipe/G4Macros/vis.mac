# vis.mac — interactive view of the light pipe, run by bbrsimLightPipe when it
# is started with no macro argument.
/control/verbose 2
/run/verbose 2
# Emitter inside the 5 mm bore, as in lightpipe.mac; the default box would
# reach into the wall (LP002).
/bbr/thermal/emitterCenter -51 0 0 mm
/bbr/thermal/emitterSize 1 7 7 mm
/run/initialize
/vis/open
/vis/viewer/set/autoRefresh false
/vis/verbose errors
#
# Geometry: hide the world box; draw the light-pipe wall translucent.
/vis/drawVolume
/vis/geometry/set/visibility logic-World 0 false
/vis/geometry/set/colour logic-LightPipe 0 0.85 0.45 0.2 0.25
/vis/viewer/set/style surface
/vis/viewer/set/background white
/vis/viewer/set/viewpointThetaPhi 70 20 deg
#
# Photon tracks in red, accumulated over all the events of a run.
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/set 0 red
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts true
/vis/modeling/trajectories/drawByCharge-0/default/setStepPtsSize 2
/vis/scene/endOfEventAction accumulate
/vis/viewer/set/autoRefresh true
/vis/verbose warnings
