# Diffraction smoke test — normal incidence, 45/45 polarization, crack1.
# Expected: T_obs ≈ 0.50  (theory: 0.5*T_Ephi0 + 0.5*T_Ephi1 ≈ 0.5*1.055 + 0 ≈ 0.528)
#
# Photon: 500 GHz optical photon (E = 2.068 meV) traveling along +x at z=0.
# Geometry: BBRCrackDetectorConstruction — two TEM_waveguide slabs side by side:
#   crack1 (b=50 µm,  depth=1 mm)   centered at (x=0, y=0, z=0 mm)   ← this test
#   crack2 (b=100 µm, depth=1.5 mm) centered at (x=0, y=0, z=3 mm)
# Source at x = -20 mm, z = 0: hits crack1 only.
#
# Polarization angle 225 deg → phat = (0, -cos45, -sin45) = (0, -0.7071, -0.7071)
# so that E_theta = phat · ê_θ_in = 1/√2 and E_phi = phat · ê_φ_in = 1/√2.

/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/run/numberOfThreads 1
/run/initialize

# Particle gun settings are hardcoded in BBRDiffractionPGA:
#   opticalphoton, position (-20,0,0) mm, direction (+1,0,0),
#   energy 2.068 meV (500 GHz), phat = (0,-1/√2,-1/√2).

/random/setSeeds 1234 5678

/run/beamOn 1000
