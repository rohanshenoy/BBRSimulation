# verify_config_mt.mac
# MT verification: two runs in one session at different emitter temperatures.
# Proves each worker's BBRConfigManager clone updates between runs (broadcast).
# Run 0: 4 K.  Run 1: 10 K (overwrites output/bbr.root).
# Gate: check_planck_spectrum on the final file must PASS at --temp 10.

/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/run/initialize

# Run 0 at 4 K
/random/setSeeds 42 1337
/bbr/thermal/setT 4.0
/run/beamOn 20000

# Run 1 at 10 K (the worker clones must pick up this broadcast)
/random/setSeeds 7 99
/bbr/thermal/setT 10.0
/run/beamOn 20000
